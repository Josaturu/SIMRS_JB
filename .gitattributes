# Auto detect text files and perform LF normalization
* text=auto

# PHP files
*.php text eol=lf
*.phtml text eol=lf

# JavaScript
*.js text eol=lf
*.json text eol=lf

# CSS
*.css text eol=lf
*.scss text eol=lf

# HTML/XML
*.html text eol=lf
*.xml text eol=lf

# SQL
*.sql text eol=lf

# Markdown
*.md text eol=lf

# Shell scripts
*.sh text eol=lf

# Config files
.htaccess text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files (no conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.rar binary
